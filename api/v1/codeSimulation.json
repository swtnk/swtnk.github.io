  {
    "name": "Incident Resolution Time Distribution",
    "language": "java",
    "code": [
      "int[] resolutionMinutes = {12, 18, 21, 24, 27, 30, 33, 36, 40, 44, 48, 55, 63, 74};",
      "int[] bins = {0, 15, 30, 45, 60, 75, 90};",
      "int[] counts = new int[bins.length - 1];",
      "for (int minute : resolutionMinutes) {",
      "  for (int i = 0; i < bins.length - 1; i++) {",
      "    if (minute >= bins[i] && minute < bins[i + 1]) { counts[i]++; break; }",
      "  }",
      "}"
    ],
    "outputType": "histogram",
    "output": {
      "labels": ["0-15", "15-30", "30-45", "45-60", "60-75", "75-90"],
      "datasets": [
        {
          "label": "Incidents",
          "data": [1, 4, 5, 2, 2, 0],
          "backgroundColor": "rgba(250,204,21,0.45)",
          "borderColor": "rgba(250,204,21,1)"
        }
      ]
    }
  },
