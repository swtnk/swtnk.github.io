  {
    "name": "Stock Price Trend with Volume Spikes",
    "language": "python",
    "code": [
      "import pandas as pd",
      "ticks = pd.DataFrame({",
      "  'day': ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],",
      "  'close_usd': [182.4, 184.1, 183.2, 186.7, 189.5, 188.9, 191.3],",
      "  'volume_m': [3.1, 3.8, 3.3, 4.6, 5.2, 4.4, 5.9]",
      "})",
      "ticks['daily_change_pct'] = ticks['close_usd'].pct_change().fillna(0) * 100",
      "momentum = ticks['close_usd'].rolling(3).mean().round(2)"
    ],
    "outputType": "line",
    "output": {
      "labels": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
