  {
    "name": "Revenue Mix by Product Segment",
    "language": "python",
    "code": [
      "import pandas as pd",
      "segments = pd.DataFrame(",
      "    [",
      "        (\"Platform\", 42),",
      "        (\"Integrations\", 21),",
      "        (\"Services\", 18),",
      "        (\"Enterprise Add-ons\", 12),",
      "        (\"Training\", 7)",
      "    ],",
      "    columns=[\"segment\", \"revenue_m\"]",
      ")",
      "share = (segments[\"revenue_m\"] / segments[\"revenue_m\"].sum()) * 100",
      "segments[\"share_pct\"] = share.round(1)"
    ],
    "outputType": "pie",
    "output": {
      "labels": ["Platform", "Integrations", "Services", "Enterprise Add-ons", "Training"],
      "datasets": [
        {
          "label": "Revenue share",
          "data": [42, 21, 18, 12, 7],
          "backgroundColor": [
            "rgba(56,189,248,0.72)",
            "rgba(168,85,247,0.7)",
            "rgba(34,197,94,0.68)",
            "rgba(250,204,21,0.65)",
            "rgba(248,113,113,0.66)"
          ],
          "borderColor": "rgba(15,23,42,0.65)"
        }
      ]
    }
  },
  {
    "name": "Regional Delivery Throughput",
    "language": "java",
    "code": [
      "record RegionStat(String region, int jobsProcessed) {}",
      "var stats = List.of(",
      "  new RegionStat(\"North\", 1260),",
      "  new RegionStat(\"South\", 980),",
      "  new RegionStat(\"East\", 1340),",
      "  new RegionStat(\"West\", 1125)",
      ");",
      "int peak = stats.stream().mapToInt(RegionStat::jobsProcessed).max().orElse(0);",
      "double utilization = stats.stream().mapToInt(RegionStat::jobsProcessed).average().orElse(0) / peak;"
    ],
    "outputType": "bar",
    "output": {
      "labels": ["North", "South", "East", "West"],
      "datasets": [
        {
          "label": "Jobs processed",
          "data": [1260, 980, 1340, 1125],
          "backgroundColor": "rgba(56,189,248,0.42)",
          "borderColor": "rgba(56,189,248,1)"
        }
      ]
    }
  },
