    "name": "Geo Distribution of Active Accounts",
    "language": "java",
    "code": [
      "record RegionUsers(String region, int activeAccounts) {}",
      "var distribution = List.of(",
      "  new RegionUsers(\"North America\", 45200),",
      "  new RegionUsers(\"Europe\", 33600),",
      "  new RegionUsers(\"APAC\", 38900),",
      "  new RegionUsers(\"LATAM\", 16800),",
      "  new RegionUsers(\"MEA\", 12400)",
      ");",
      "int globalTotal = distribution.stream().mapToInt(RegionUsers::activeAccounts).sum();",
      "double apacShare = distribution.get(2).activeAccounts() * 100.0 / globalTotal;"
    ],
    "outputType": "bar",
    "output": {
